<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ extraction rules: keep cloud backups and device-to-device transfer
  for app data, but never include the SharedPreferences file that holds API keys.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="prefs.xml" />
    </device-transfer>
</data-extraction-rules>
